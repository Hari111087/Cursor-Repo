# Copy to .env.local and fill in. NEVER commit real values.

# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# "true" runs the whole UI on mock data with no database or Google login.
DEMO_MODE=true
# Only this Google account may sign in (single-user app).
ALLOWED_EMAIL=hari@example.com
# Display name used in greetings
NEXT_PUBLIC_OWNER_NAME=Hari
# IANA timezone used for briefings, quiet hours and scheduling
APP_TIMEZONE=Asia/Kolkata

# ── Database (PostgreSQL / Supabase) ───────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/haris_assistant

# ── Auth (NextAuth + Google OAuth) ─────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 32
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte key, base64. Encrypts OAuth tokens at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Anthropic Claude ───────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# ── Market data ────────────────────────────────────────────────────
FINNHUB_API_KEY=
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── Web Push (npm run vapid) ───────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hari@example.com

# ── Background jobs ────────────────────────────────────────────────
# Shared secret that Vercel Cron / the worker sends as a Bearer token
CRON_SECRET=
