  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.33",
    "postcss": "^8.5.28",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
